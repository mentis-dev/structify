{
    "type": "object",
    "properties": {
        "stakeholders": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the stakeholder organization or individual."
                    },
                    "category": {
                        "type": "string",
                        "description": "The category of the stakeholder (Regulator, Supplier, Consumer, Competitor, Partner, Influencer, Internal)."
                    },
                    "role": {
                        "type": "string",
                        "description": "Brief description of the stakeholder's role or function."
                    },
                    "confidence": {
                        "type": "number",
                        "description": "Confidence score (0-100%) for the classification."
                    },
                    "hierarchy_level": {
                        "type": "string",
                        "description": "Level in the ecosystem hierarchy (Macro, Meso, Micro)."
                    },
                    "themes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Broad themes or domains this stakeholder relates to (e.g., healthcare, education, technology, regulation, finance)."
                    },
                    "influence_scope": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Stakeholder's potential influence on system-wide changes."
                    },
                    "intervention_capacity": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Stakeholder's capacity to implement solutions or changes."
                    },
                    "decision_authority": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Level of decision-making authority this stakeholder has."
                    },
                    "resource_control": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Level of control over resources (financial, human, material) relevant to potential solutions."
                    },
                    "challenge_relevance_capacity": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Stakeholder's potential to contribute meaningfully to challenge-based interventions."
                    },
                    "cross_theme_connections": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Level of connection across multiple themes, indicating versatility in challenge addressing."
                    }
                },
                "required": ["name", "category", "role", "confidence", "hierarchy_level", "themes", "influence_scope", "intervention_capacity", "challenge_relevance_capacity", "cross_theme_connections"]
            },
            "description": "List of stakeholders identified in the text."
        },
        "factors": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "Label": {
                        "type": "string",
                        "description": "The descriptive name for the factor."
                    },
                    "Type": {
                        "type": "string",
                        "description": "Classification type (e.g., Indirect Driver, Exogenous Driver, Outcome, Direct Driver)."
                    },
                    "Tags": {
                        "type": "string",
                        "description": "Any additional tags or keywords (optional)."
                    },
                    "Description": {
                        "type": "string",
                        "description": "A detailed description of the factor including stakeholder information."
                    },
                    "themes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Broad themes or domains this factor relates to."
                    },
                    "system_influence": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Level of influence this factor has on the overall system."
                    }
                },
                "required": ["Label", "Type", "Description", "themes"]
            },
            "description": "List of factors identified in the text."
        },
        "pain_points": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "A unique identifier for the pain point (e.g., PP-001)."
                    },
                    "category": {
                        "type": "string",
                        "description": "The category of the pain point (e.g., Healthcare Access, Financial Barriers)."
                    },
                    "description": {
                        "type": "string",
                        "description": "A brief description of the pain point."
                    },
                    "affected_stakeholders": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List of stakeholder names that experience or are affected by this pain point."
                    },
                    "causing_stakeholders": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "List of stakeholder names that cause or contribute to this pain point (optional)."
                    },
                    "stakeholder_impact": {
                        "type": "object",
                        "description": "Detailed impact description for each affected stakeholder",
                        "additionalProperties": {
                            "type": "string",
                            "description": "Description of how this pain point specifically affects the named stakeholder"
                        }
                    },
                    "confidence": {
                        "type": "number",
                        "description": "Confidence score (0-100%) for this pain point identification."
                    },
                    "hierarchy_level": {
                        "type": "string",
                        "description": "Level in the ecosystem hierarchy (Macro, Meso, Micro)."
                    },
                    "severity": {
                        "type": "string",
                        "enum": ["Low", "Medium", "High", "Critical"],
                        "description": "Severity level of the pain point based on text evidence."
                    },
                    "themes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Broad themes or domains this pain point relates to."
                    },
                    "system_impact": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Impact level on the overall system if this pain point persists."
                    },
                    "urgency": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low"],
                        "description": "How urgent it is to address this pain point."
                    },
                    "intervention_difficulty": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "How difficult it would be to address or solve this pain point."
                    }
                },
                "required": ["id", "category", "description", "affected_stakeholders", "confidence", "themes", "system_impact"]
            },
            "description": "List of pain points identified in the text, with explicit stakeholder relationships."
        },
        "relationships": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "A unique identifier for the relationship (e.g., REL-001)."
                    },
                    "source_stakeholder": {
                        "type": "string",
                        "description": "The name of the source stakeholder in the relationship."
                    },
                    "target_stakeholder": {
                        "type": "string",
                        "description": "The name of the target stakeholder in the relationship."
                    },
                    "relationship_type": {
                        "type": "string",
                        "description": "The primary type of relationship (e.g., Regulatory, Collaborative, Competitive, Transactional, Hierarchical, Informational)."
                    },
                    "relationship_subtype": {
                        "type": "string",
                        "description": "The specific subtype of relationship (e.g., Oversight, Partnership, Rivalry, Service Provision, Reporting, Advisory)."
                    },
                    "direction": {
                        "type": "string",
                        "description": "The direction of the relationship (Bidirectional, Unidirectional_Source_to_Target, Unidirectional_Target_to_Source)."
                    },
                    "strength": {
                        "type": "number",
                        "description": "The strength of the relationship (0-100%), based on frequency of interaction or importance mentioned in text."
                    },
                    "justification": {
                        "type": "string",
                        "description": "Detailed justification for this relationship based on evidence from the text, including specific quotes or references."
                    },
                    "confidence": {
                        "type": "number",
                        "description": "Confidence score (0-100%) for this relationship identification."
                    },
                    "collaboration_potential": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Potential for these stakeholders to collaborate on solutions."
                    },
                    "conflict_potential": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                        "description": "Potential for conflict or tension between these stakeholders."
                    }
                },
                "required": ["id", "source_stakeholder", "target_stakeholder", "relationship_type", "relationship_subtype", "direction", "strength", "justification", "confidence"]
            },
            "description": "List of relationships between stakeholders identified in the text."
        },
        "thematic_analysis": {
            "type": "object",
            "properties": {
                "identified_themes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "theme_name": {
                                "type": "string",
                                "description": "Name of the identified theme (e.g., 'healthcare access', 'digital transformation', 'regulatory compliance')."
                            },
                            "description": {
                                "type": "string",
                                "description": "Detailed description of what this theme encompasses."
                            },
                            "prevalence": {
                                "type": "string",
                                "enum": ["high", "medium", "low"],
                                "description": "How prevalent this theme is across the analyzed content."
                            },
                            "related_stakeholders": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Names of stakeholders related to this theme."
                            },
                            "related_pain_points": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "IDs of pain points related to this theme."
                            },
                            "related_factors": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Labels of factors related to this theme."
                            },
                            "potential_challenges": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Potential challenges that could be defined around this theme."
                            }
                        },
                        "required": ["theme_name", "description", "prevalence"]
                    },
                    "description": "List of main themes identified across all analyzed content."
                },
                "cross_cutting_themes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "theme_name": {
                                "type": "string",
                                "description": "Name of the cross-cutting theme."
                            },
                            "description": {
                                "type": "string",
                                "description": "Description of how this theme cuts across multiple categories."
                            },
                            "stakeholder_categories": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Stakeholder categories this theme spans."
                            },
                            "hierarchy_levels": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Hierarchy levels this theme spans."
                            }
                        },
                        "required": ["theme_name", "description"]
                    },
                    "description": "Themes that cut across multiple stakeholder categories or hierarchy levels."
                },
                "theme_clusters": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "cluster_name": {
                                "type": "string",
                                "description": "Name for this cluster of related themes."
                            },
                            "themes": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Theme names that belong to this cluster."
                            },
                            "cluster_description": {
                                "type": "string",
                                "description": "Description of how these themes relate to each other."
                            }
                        },
                        "required": ["cluster_name", "themes", "cluster_description"]
                    },
                    "description": "Clusters of related themes that often appear together."
                }
            },
            "description": "Comprehensive thematic analysis of the extracted content."
        },
        "challenge_readiness": {
            "type": "object",
            "properties": {
                "suggested_challenges": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "challenge_name": {
                                "type": "string",
                                "description": "Suggested name for a potential challenge."
                            },
                            "challenge_description": {
                                "type": "string",
                                "description": "Description of what this challenge would encompass."
                            },
                            "primary_themes": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Primary themes this challenge would address."
                            },
                            "key_stakeholders": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Key stakeholders who would be central to this challenge."
                            },
                            "critical_pain_points": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Critical pain points this challenge would address."
                            },
                            "complexity_level": {
                                "type": "string",
                                "enum": ["high", "medium", "low"],
                                "description": "Estimated complexity level of addressing this challenge."
                            }
                        },
                        "required": ["challenge_name", "challenge_description", "primary_themes"]
                    },
                    "description": "Suggested challenges that could be defined based on the analyzed content."
                },
                "visualization_metadata": {
                    "type": "object",
                    "properties": {
                        "stakeholder_influence_map": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "properties": {
                                    "influence_score": {
                                        "type": "number",
                                        "description": "Combined influence score (0-100) based on scope, capacity, authority, and resources."
                                    },
                                    "themes": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "description": "Mapping of stakeholder names to their influence metrics and themes."
                        },
                        "pain_point_impact_map": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "properties": {
                                    "impact_score": {
                                        "type": "number",
                                        "description": "Combined impact score based on system impact, severity, and urgency."
                                    },
                                    "themes": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "description": "Mapping of pain point IDs to their impact metrics and themes."
                        },
                        "theme_connectivity": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "properties": {
                                    "connected_themes": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "connection_strength": {
                                        "type": "number",
                                        "description": "Strength of connection to other themes (0-100)."
                                    }
                                }
                            },
                            "description": "Mapping of theme interconnections for network visualization."
                        },
                        "challenge_affinity_scores": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "properties": {
                                    "base_challenge_score": {
                                        "type": "number",
                                        "description": "Base score (0-100) for general challenge engagement potential."
                                    },
                                    "theme_versatility": {
                                        "type": "number", 
                                        "description": "Score for ability to address multiple themes simultaneously."
                                    }
                                }
                            },
                            "description": "Pre-computed scores for how well each stakeholder could engage with challenges."
                        }
                    },
                    "description": "Pre-computed metadata to support various visualization approaches."
                }
            },
            "description": "Information prepared specifically to support challenge-based analysis and visualization."
        }
    },
    "required": [
        "stakeholders",
        "factors", 
        "pain_points",
        "relationships",
        "thematic_analysis",
        "challenge_readiness"
    ]
}